SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0

PRODUCT_NAME = MichaelOS
PRODUCT_BUNDLE_IDENTIFIER = com.michaelos.app
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
ENABLE_PREVIEWS = YES
DEAD_CODE_STRIPPING = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = MichaelOS
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait

ALWAYS_SEARCH_USER_PATHS = NO

// The legal pages are not written yet (mobile/docs/backlog.md); these are the addresses they will have.
LEGAL_TERMS_URL = https:/$()/michaelos.com/terms
LEGAL_PRIVACY_URL = https:/$()/michaelos.com/privacy
