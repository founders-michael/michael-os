    "review.line.talk.prompt %@": {
      "comment": "Request put in Michael's composer; {1} is the date. Mirrors the web's assistant page for a review date.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the get_daily_review tool for %@. Summarize what I planned and completed, explain which commitments remain unfinished, and suggest realistic priorities for the next day. Clearly say when actual tracking or historical records are unavailable. Recommendations are suggestions only; do not make changes."
          }
        }
