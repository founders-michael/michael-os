    "settings.account.problem.long": {
      "comment": "A name is too long. Mirrors the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it to 80 characters."
          }
        }
      }
    },
    "settings.account.problem.missing": {
      "comment": "A name is empty. Mirrors the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a name."
          }
        }
      }
    },
