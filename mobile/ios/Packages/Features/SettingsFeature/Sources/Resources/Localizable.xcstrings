    "settings.availability.none": {
      "comment": "A weekday with no windows",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available"
          }
        }
      }
    },
    "settings.availability.note": {
      "comment": "Under the week",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A window can't cross midnight. Tap a window to change or remove it."
          }
        }
      }
    },
    "settings.availability.order": {
      "comment": "A window is empty or crosses midnight. Mirrors the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A window must end after it starts, before midnight."
          }
