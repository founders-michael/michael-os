    "settings.context": {
      "comment": "Row and title of the My Context screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My Context"
          }
        }
      }
    },
    "settings.context.conflict": {
      "comment": "Shown after a refused save",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your context was changed on another device since you opened it. Keep your version, or use the one that was saved."
          }
        }
      }
    },
    "settings.context.conflict.empty": {
      "comment": "The copy saved elsewhere is empty",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(empty)"
          }
        }
      }
    },
    "settings.context.conflict.saved": {
      "comment": "Label over the copy saved on another device",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved elsewhere"
          }
        }
      }
    },
    "settings.context.count %lld %lld": {
      "comment": "Characters used and the limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "settings.context.intro": {
      "comment": "Under the My Context title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Michael reads this before every reply. Write what you'd tell a new assistant about your work, family and the way you like to plan."
          }
        }
      }
    },
    "settings.context.keepMine": {
      "comment": "Saves this device's text over the other copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep mine"
          }
        }
      }
    },
    "settings.context.placeholder": {
      "comment": "Placeholder of the My Context field",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I work best in the mornings…"
          }
        }
      }
    },
    "settings.context.useSaved": {
      "comment": "Replaces this device's text with the saved copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the saved one"
          }
        }
      }
    },
    "settings.delete": {
      "comment": "Row and title of the delete account screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        }
      }
    },
    "settings.delete.confirm": {
      "comment": "Deletes the account",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete my account"
          }
        }
      }
    },
    "settings.delete.intro": {
      "comment": "First line of the delete screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting your account can't be undone."
          }
        }
      }
    },
    "settings.delete.organization": {
      "comment": "Deletion refused for an organization member. Mirrors docs/account-deletion.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account belongs to an organization, so it can't be deleted here yet. Write to support@michaelos.com and we'll remove it."
          }
        }
      }
    },
    "settings.delete.password": {
      "comment": "Password field on the delete screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        }
      }
    },
    "settings.delete.removed": {
      "comment": "What deletion removes. Mirrors docs/account-deletion.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in it is removed: your profile, picture and context, tasks and their history, goals and milestones, habits and check-ins, calendar events, daily reviews, memories, and your conversations with Michael. You'll be signed out, and the email can be used for a new account."
          }
        }
      }
    },
    "settings.delete.type %@": {
      "comment": "Field label; {1} is the word to type",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type %@ to confirm"
          }
        }
      }
    },
    "settings.delete.wrongPassword": {
      "comment": "Wrong password on delete",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That password isn't right. Try again."
          }
        }
      }
    },
