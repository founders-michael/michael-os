    },
    "settings.availability.overlap": {
      "comment": "Two windows on one day overlap. Mirrors the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These windows overlap. Change one before saving."
          }
        }
      }
    },
    "settings.availability.paused": {
      "comment": "A window kept but not used",
