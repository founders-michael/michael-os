      "comment": "Under the My Context title",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Michael reads this before every reply. Write what you'd tell a new assistant about your work, family and the way you like to plan."
