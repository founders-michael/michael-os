    "settings.delete.organization": {
      "comment": "Deletion refused for an organization member. Mirrors docs/account-deletion.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account belongs to an organization, so it can't be deleted here yet. Write to support@michaelos.com and we'll remove it."
          }
        }
      }
    },
    "settings.delete.password": {
      "comment": "Password field on the delete screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        }
      }
    },
    "settings.delete.removed": {
      "comment": "What deletion removes. Mirrors docs/account-deletion.md.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in it is removed: your profile, picture and context, tasks and their history, goals and milestones, habits and check-ins, calendar events, daily reviews, memories, and your conversations with Michael. You'll be signed out, and the email can be used for a new account."
          }
        }
      }
    },
    "settings.delete.type %@": {
      "comment": "Field label; {1} is the word to type",
