    "tasks.delete.message": {
      "comment": "Delete confirmation for a one-off task.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed for good, with its history and any time planned for it."
          }
        }
      }
    },
    "tasks.delete.message.repeating": {
      "comment": "Delete confirmation for a repeating task. Same rule as the web.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed for good, with its history and any time planned for it. It repeats: deleting the newest one also stops the repeat, and earlier ones stay. To move just this one, skip it instead."
          }
        }
      }
    },
    "tasks.delete.title": {
      "comment": "Title of the delete confirmation.",
      "extractionState": "manual",
      "localizations": {
