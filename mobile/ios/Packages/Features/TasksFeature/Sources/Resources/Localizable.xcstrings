{
  "sourceLanguage": "en",
  "strings": {
    "tasks.capture.label": {
      "comment": "Accessibility label of the natural-language capture field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a task for Michael to draft"
          }
        }
      }
    },
    "tasks.capture.placeholder": {
      "comment": "Placeholder of the natural-language capture field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call the bank on Friday, 20 minutes"
          }
        }
      }
    },
    "tasks.capture.prompt %@": {
      "comment": "The request put in Michael's composer, followed by what the user typed. Same wording as the web.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft a task from this, filling in the due date, priority and time estimate where I mention them: %@"
          }
        }
      }
    },
    "tasks.capture.send": {
      "comment": "Accessibility label of the capture button. It opens Michael with the request filled in; nothing is sent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft this task with Michael"
          }
        }
      }
    },
    "tasks.categories.add": {
      "comment": "Opens the list of categories.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a category"
          }
        }
      }
    },
    "tasks.categories.asking": {
      "comment": "Accessibility label while Michael suggests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asking Michael"
          }
        }
      }
    },
    "tasks.categories.confirm": {
      "comment": "Keeps Michael's suggestion as the user's category.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        }
      }
    },
    "tasks.categories.dataUse": {
      "comment": "Same wording as the web, shown when the server asks.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggesting a category sends this task's title and description to Gemini under its unpaid-tier data terms, which may use submitted content. Continue only if that's acceptable."
          }
        }
      }
    },
    "tasks.categories.dataUse.accept": {
      "comment": "Sends the suggestion request with the acknowledgement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        }
      }
    },
    "tasks.categories.dataUse.decline": {
      "comment": "Closes the notice without asking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        }
      }
    },
    "tasks.categories.dismiss": {
      "comment": "Removes Michael's suggestion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        }
      }
    },
    "tasks.categories.loading": {
      "comment": "Accessibility label while the categories load.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading categories"
          }
        }
      }
    },
    "tasks.categories.noFit": {
      "comment": "No suggestion came back.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Michael didn't find a category that clearly fits. You can choose one yourself."
          }
        }
      }
    },
    "tasks.categories.none": {
      "comment": "The task has no category.",
