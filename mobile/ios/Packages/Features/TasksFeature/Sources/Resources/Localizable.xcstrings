    "tasks.count %lld": {
      "comment": "How many tasks match the filters.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld task"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld tasks"
                }
              }
            }
          }
        }
      }
    },
    "tasks.count.overdue %@ %lld": {
      "comment": "The task count, then how many open tasks are overdue.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld overdue"
          }
        }
      }
