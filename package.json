{
  "name": "michael-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test \"src/lib/*.test.ts\" \"src/lib/ai/*.test.ts\"",
    "test:planner": "cd services/planner && ./.venv/bin/python -m pytest -q",
    "test:authorization": "node ./scripts/test-support/run-authorization-suite.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:planner && npm run db:validate",
    "verify:full": "npm run verify && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:check": "tsx scripts/check-db.ts",
    "test:onboarding": "tsx scripts/onboarding-smoke.ts",
    "test:tasks": "tsx scripts/task-smoke.ts",
    "test:goals": "tsx scripts/goal-smoke.ts",
    "test:habits": "tsx scripts/habit-smoke.ts",
    "test:calendar": "tsx scripts/calendar-smoke.ts",
    "test:planning": "tsx scripts/planning-smoke.ts",
    "test:organizations:unit": "tsx --test src/lib/organization-permissions.test.ts src/lib/organization-validation.test.ts src/lib/organization-structure-validation.test.ts src/lib/organization-invitation-status.test.ts src/lib/auth-return-to.test.ts src/lib/workspace-navigation.test.ts",
    "test:products:unit": "tsx --test src/lib/product-permission-policy.test.ts src/lib/product-entry.test.ts",
    "test:organizations": "tsx scripts/organization-smoke.ts",
    "test:calendar-contract": "tsx --test src/lib/calendar-availability.test.ts src/lib/calendar-event-date.test.ts src/lib/timezone-options.test.ts src/lib/habit-summary.test.ts",
    "test:ux": "tsx --test src/lib/optimistic-update.test.ts src/lib/notifications.test.ts src/lib/keyboard-shortcuts.test.ts src/lib/command-palette.test.ts src/lib/debounce.test.ts src/lib/form-validation.test.ts src/lib/autosave-controller.test.ts src/lib/work-task-validation.test.ts src/lib/work-task-board-dnd.test.ts src/lib/work-task-permissions.test.ts",
    "test:ai": "tsx --test src/lib/ai/*.test.ts",
    "test:capacity": "tsx --test src/lib/capacity-calculator.test.ts src/lib/capacity-validation.test.ts",
    "test:cache": "tsx --test src/lib/server-cache-core.test.ts src/lib/query-client.test.ts src/lib/resource-cache.test.ts",
    "benchmark:cache": "node scripts/p1-redis-benchmark.mjs"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.3",
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
