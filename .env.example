# AI assistant (server only). Disabled until explicitly enabled.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set to "paid" only after confirming the Gemini project is on the paid tier.
# Unpaid-tier data processing is refused in production.
GEMINI_DATA_TIER=unpaid
AI_MAX_TOOL_CALLS=5
AI_MAX_ITERATIONS=4
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_CHARS=6000

# Optional shared cache. Supplying both Upstash variables enables it unless explicitly disabled.
# Set REDIS_ENABLED=false to force database-only operation; true requires both values.
# Keep these server-only and use separate Upstash databases for development/staging/production.
REDIS_ENABLED=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
