# AI assistant (server only). Disabled until explicitly enabled.
# Michael's turns run in services/intelligence; its own .env holds the model, the API key and the turn limits.
# AI_PROVIDER and GEMINI_DATA_TIER must match that file: this server names the provider to users and asks for the
# data-terms acknowledgement, and the engine refuses a turn whose provider differs.
AI_ENABLED=false
AI_PROVIDER=gemini
# Set to "paid" only after confirming the Gemini project is on the paid tier.
# Unpaid-tier data processing is refused in production.
GEMINI_DATA_TIER=unpaid
AI_MAX_INPUT_CHARS=4000
# The engine's address and shared bearer token (at least 32 characters; same value in services/intelligence/.env).
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:8100
INTELLIGENCE_SERVICE_TOKEN=

# Optional shared cache. Supplying both Upstash variables enables it unless explicitly disabled.
# Set REDIS_ENABLED=false to force database-only operation; true requires both values.
# Keep these server-only and use separate Upstash databases for development/staging/production.
REDIS_ENABLED=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-side allowlist for product entitlement administration.
# Comma-separated Better Auth user IDs; never grant product access from a client.
MICHAELOS_PRODUCT_ACCESS_ADMIN_USER_IDS=

# Canonical public origin, used for canonical URLs, Open Graph image URLs,
# robots.txt and the sitemap. Deliberately separate from BETTER_AUTH_URL, which
# is the auth callback origin. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (verification links) through Resend. Without a key,
# development logs the link to the server console; production refuses to send,
# and because sign-in requires a verified email, new users cannot get in.
# EMAIL_FROM must use a domain verified in Resend, e.g. "MichaelOS <hello@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Social sign-in. A provider's button appears only when both its values are set.
# Redirect URIs to register with each provider: <BETTER_AUTH_URL>/api/auth/callback/google
# and <BETTER_AUTH_URL>/api/auth/callback/github (one per environment).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Native app sign-in with Google. Optional. Each is the OAuth client ID Google
# issues for that platform in the same Google Cloud project as GOOGLE_CLIENT_ID.
# They let the server accept ID tokens from the native Google SDKs; they have
# no secret and do not affect the web redirect flow.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
