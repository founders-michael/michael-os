generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model AppMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?
  tasks         Task[]
  goals         Goal[]
  habits        Habit[]
  calendarEvents CalendarEvent[]
  availabilityWindows AvailabilityWindow[]
  organizationMemberships OrganizationMembership[]
  productPermissionsReceived UserProductPermission[] @relation("ProductPermissionSubject")
  productPermissionsGranted UserProductPermission[] @relation("ProductPermissionGrantor")
  dailyReviews DailyReview[]
  personalTaskPlanHistory PersonalTaskPlanHistory[]
  aiConversations AiConversation[]
  context UserContext?
  profileImage UserProfileImage?

  classifications        EntityClassification[] @relation("EntityClassificationOwner")
  classificationsCreated EntityClassification[] @relation("EntityClassificationCreatedBy")
  relationships          EntityRelationship[]   @relation("EntityRelationshipOwner")
  memories               MemoryItem[]           @relation("MemoryItemOwner")
  memoriesCreated        MemoryItem[]           @relation("MemoryItemCreatedBy")
  outcomes               OutcomeEvent[]         @relation("OutcomeEventOwner")
  taskRecurrences        TaskRecurrence[]
  outcomesActed          OutcomeEvent[]         @relation("OutcomeEventActor")
  @@unique([email])
  @@map("user")
}

enum ProductPermission {
  LIFESTYLE_OS_ACCESS
  WORK_OS_ACCESS
}

model UserProductPermission {
  id         String            @id @default(cuid())
  userId     String
  permission ProductPermission
  grantedAt  DateTime          @default(now()) @db.Timestamptz(3)
  grantedBy  String?
  user       User              @relation("ProductPermissionSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantor    User?             @relation("ProductPermissionGrantor", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, permission])
  @@index([permission, userId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationInvitationRole {
  ADMIN
  MANAGER
  MEMBER
}

enum ManagerDefaultScope {
  TEAM
  ORGANIZATION
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectMembershipRole {
  MEMBER
  CONTRIBUTOR
  VIEWER
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum WorkTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkTaskActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  ASSOCIATION_CHANGED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
  ARCHIVED
  RESTORED
}

model Organization {
  id          String                   @id @default(cuid())
  name        String                   @db.VarChar(120)
  slug        String                   @unique @db.VarChar(80)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]
  policy      OrganizationPolicy?
  teams       Team[]
  projects    Project[]
  auditEvents OrganizationAuditEvent[]
  workTasks   WorkTask[]
  projectMilestones ProjectMilestone[]
  aiConversations AiConversation[]
  workTaskAssignments WorkTaskAssignment[]
  workTaskDependencies WorkTaskDependency[]
  workTaskActivities WorkTaskActivity[]
  teamCapacityPolicies TeamCapacityPolicy[]
  memberAvailabilities MemberAvailability[]
  memberAvailabilityExceptions MemberAvailabilityException[]

  classifications EntityClassification[]
  memories        MemoryItem[]
  outcomes        OutcomeEvent[]
  @@index([createdAt])
}

model OrganizationMembership {
  id                   String                       @id @default(cuid())
  organizationId       String
  userId               String
  role                 OrganizationRole             @default(MEMBER)
  status               OrganizationMembershipStatus @default(ACTIVE)
  joinedAt             DateTime                     @default(now())
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitationsSent      OrganizationInvitation[]     @relation("InvitationInviter")
  teamMemberships      TeamMembership[]
  projectMemberships   ProjectMembership[]
  teamsLed             Team[]                       @relation("TeamLead")
  projectsOwned        Project[]                    @relation("ProjectOwner")
  auditEvents          OrganizationAuditEvent[]     @relation("OrganizationAuditActor")
  workTasksCreated     WorkTask[]                   @relation("WorkTaskCreator")
  workTaskAssignments  WorkTaskAssignment[]         @relation("WorkTaskAssignee")
  workTaskAssignmentsMade WorkTaskAssignment[]      @relation("WorkTaskAssigner")
  workTaskDependenciesCreated WorkTaskDependency[]  @relation("WorkTaskDependencyCreator")
  workTaskActivities   WorkTaskActivity[]           @relation("WorkTaskActivityActor")
  projectMilestonesCreated ProjectMilestone[]       @relation("ProjectMilestoneCreator")
  memberAvailability MemberAvailability?

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@unique([organizationId], where: raw("\"role\" = 'OWNER' AND \"status\" = 'ACTIVE'"), map: "OrganizationMembership_one_active_owner_per_org_key")
  @@index([userId, status])
  @@index([organizationId, status, role])
}

model OrganizationInvitation {
  id                    String                     @id @default(cuid())
  organizationId        String
  email                 String                     @db.VarChar(320)
  role                  OrganizationInvitationRole
  tokenHash             String                     @unique @db.VarChar(64)
  invitedByMembershipId String
  expiresAt             DateTime                   @db.Timestamptz(3)
  acceptedAt            DateTime?                  @db.Timestamptz(3)
  revokedAt             DateTime?                  @db.Timestamptz(3)
  declinedAt            DateTime?                  @db.Timestamptz(3)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedByMembership  OrganizationMembership     @relation("InvitationInviter", fields: [invitedByMembershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([expiresAt])
  @@unique([organizationId, email], where: raw("\"acceptedAt\" IS NULL AND \"revokedAt\" IS NULL AND \"declinedAt\" IS NULL"), map: "OrganizationInvitation_one_pending_per_org_email_key")
}

model OrganizationPolicy {
  organizationId                         String             @id
  managerDefaultScope                    ManagerDefaultScope @default(TEAM)
  capacityWorkingDays                    Int[]              @default([1, 2, 3, 4, 5])
  capacityDailyStartTime                 String             @default("09:00") @db.VarChar(5)
  capacityDailyEndTime                   String             @default("17:00") @db.VarChar(5)
  capacityTimeZone                       String             @default("UTC") @db.VarChar(100)
  capacityWeeklyMinutes                  Int                @default(2400)
  underCapacityPercent                   Int                @default(50)
  nearCapacityPercent                    Int                @default(85)
  overCapacityPercent                    Int                @default(100)
  allowTeamCapacityOverrides             Boolean            @default(true)
  managersCanManageTeamCapacity          Boolean            @default(false)
  managersCanEditMemberAvailability      Boolean            @default(false)
  membersCanManageOwnAvailability        Boolean            @default(true)
  createdAt                              DateTime           @default(now())
  updatedAt                              DateTime           @updatedAt
  organization                           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(80)
  description    String?      @db.Text
  teamLeadUserId String?
  status         TeamStatus   @default(ACTIVE)
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamLead       OrganizationMembership? @relation("TeamLead", fields: [organizationId, teamLeadUserId], references: [organizationId, userId], onDelete: Restrict)
  memberships    TeamMembership[]
  projects       ProjectTeam[]
  workTasks      WorkTask[]
  capacityPolicy TeamCapacityPolicy?

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, status, name])
  @@index([organizationId, teamLeadUserId])
}

/// Nullable values inherit from OrganizationPolicy. Team policies affect only
/// team-scoped capacity views; organization totals count each member once.
model TeamCapacityPolicy {
  id                    String       @id @default(cuid())
  organizationId        String
  teamId                String
  workingDays           Int[]        @default([])
  dailyStartTime        String?      @db.VarChar(5)
  dailyEndTime          String?      @db.VarChar(5)
  timeZone              String?      @db.VarChar(100)
  weeklyCapacityMinutes Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team                  Team         @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([teamId, organizationId])
  @@index([organizationId])
}

/// Per-member overrides are optional and inherited field-by-field from the
/// organization policy. Personal LifestyleOS availability remains separate.
model MemberAvailability {
  id                    String                 @id @default(cuid())
  organizationId        String
  userId                String
  workingDays           Int[]        @default([])
  dailyStartTime        String?                @db.VarChar(5)
  dailyEndTime          String?                @db.VarChar(5)
  timeZone              String?                @db.VarChar(100)
  weeklyCapacityMinutes Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership            OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  exceptions            MemberAvailabilityException[]

  @@unique([organizationId, userId])
  @@unique([id, organizationId, userId])
  @@index([organizationId, timeZone])
}

/// Date ranges are local calendar dates in timeZone. Optional times represent
/// a local partial-day interval; null times mean full-day unavailability.
model MemberAvailabilityException {
  id             String                 @id @default(cuid())
  availabilityId String
  organizationId String
  userId         String
  startDate      DateTime               @db.Date
  endDate        DateTime               @db.Date
  startTime      String?                @db.VarChar(5)
  endTime        String?                @db.VarChar(5)
  timeZone       String                 @db.VarChar(100)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  availability   MemberAvailability     @relation(fields: [availabilityId, organizationId, userId], references: [id, organizationId, userId], onDelete: Cascade)

  @@index([organizationId, userId, startDate, endDate])
}

model TeamMembership {
  id             String                 @id @default(cuid())
  organizationId String
  teamId         String
  userId         String
  joinedAt       DateTime               @default(now())
  removedAt      DateTime?              @db.Timestamptz(3)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  team           Team                   @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)

  @@unique([organizationId, teamId, userId])
  @@index([organizationId, userId, removedAt])
  @@index([organizationId, teamId, removedAt])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  name           String          @db.VarChar(160)
  slug           String          @db.VarChar(80)
  description    String?         @db.Text
  ownerUserId    String?
  status         ProjectStatus   @default(ACTIVE)
  priority       ProjectPriority @default(MEDIUM)
  startDate      DateTime?       @db.Date
  targetEndDate  DateTime?       @db.Date
  archivedAt     DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          OrganizationMembership? @relation("ProjectOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: Restrict)
  memberships    ProjectMembership[]
  teams          ProjectTeam[]
  workTasks      WorkTask[]
  milestones     ProjectMilestone[]

  classifications EntityClassification[]
  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, ownerUserId])
  @@index([organizationId, priority, targetEndDate])
}

enum ProjectMilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A planning checkpoint within a project. Its own status is user-declared and
/// is never derived from, nor used to derive, its task metrics.
model ProjectMilestone {
  id             String                 @id @default(cuid())
  organizationId String
  projectId      String
  title          String                 @db.VarChar(160)
  description    String?                @db.Text
  status         ProjectMilestoneStatus @default(PLANNED)
  /// Calendar target date without a time, interpreted as a project planning date.
  targetDate     DateTime?              @db.Date
  /// Manual ordering within a project; ties broken by createdAt then id.
  position       Int                    @default(0)
  completedAt    DateTime?              @db.Timestamptz(3)
  archivedAt     DateTime?              @db.Timestamptz(3)
  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project                @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy      OrganizationMembership @relation("ProjectMilestoneCreator", fields: [organizationId, createdById], references: [organizationId, userId], onDelete: Restrict)
  workTasks      WorkTask[]

  @@unique([id, organizationId])
  @@unique([organizationId, projectId, title])
  @@index([organizationId, projectId, position])
  @@index([organizationId, projectId, status])
}

model ProjectMembership {
  id             String                 @id @default(cuid())
  organizationId String
  projectId      String
  userId         String
  role           ProjectMembershipRole  @default(MEMBER)
  joinedAt       DateTime               @default(now())
  removedAt      DateTime?              @db.Timestamptz(3)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  project        Project                @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)

  @@unique([organizationId, projectId, userId])
  @@index([organizationId, userId, removedAt])
  @@index([organizationId, projectId, removedAt])
  @@index([organizationId, projectId, role])
}

model ProjectTeam {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  teamId         String
  removedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now())
  project        Project   @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  team           Team      @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, projectId, teamId])
  @@index([organizationId, projectId, removedAt])
  @@index([organizationId, teamId, removedAt])
}

/// Minimal immutable record of important WorkOS structure changes; metadata excludes personal content.
model OrganizationAuditEvent {
  id             String                  @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String                  @db.VarChar(64)
  resourceType   String                  @db.VarChar(40)
  resourceId     String                  @db.VarChar(128)
  metadata       Json                    @default("{}")
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          OrganizationMembership? @relation("OrganizationAuditActor", fields: [organizationId, actorUserId], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId, createdAt])
}

model WorkTask {
  id             String          @id @default(cuid())
  organizationId String
  projectId      String?
  teamId         String?
  /// Optional milestone within the task's own project; at most one per task.
  milestoneId    String?
  title          String          @db.VarChar(200)
  description    String?         @db.Text
  status         WorkTaskStatus  @default(TODO)
  priority       WorkTaskPriority @default(MEDIUM)
  startDate      DateTime?       @db.Date
  dueDate        DateTime?       @db.Date
  estimatedMinutes Int?
  createdById    String
  archivedAt     DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  team           Team?           @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  /// Restrict, not SetNull: a composite SetNull would also clear organizationId.
  milestone      ProjectMilestone? @relation(fields: [milestoneId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy      OrganizationMembership @relation("WorkTaskCreator", fields: [organizationId, createdById], references: [organizationId, userId], onDelete: Restrict)
  assignments    WorkTaskAssignment[]
  dependencies   WorkTaskDependency[] @relation("WorkTaskDependencies")
  dependents     WorkTaskDependency[] @relation("WorkTaskDependents")
  activities     WorkTaskActivity[]

  classifications EntityClassification[]
  @@unique([id, organizationId])
  @@index([organizationId, status, priority, dueDate])
  @@index([organizationId, projectId, status])
  @@index([organizationId, teamId, status])
  @@index([organizationId, milestoneId, status])
  @@index([organizationId, createdById, createdAt])
  @@index([organizationId, updatedAt])
}

/// Assignment rows are retained after removal; only one active assignment per task/user is allowed.
model WorkTaskAssignment {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  userId         String
  assignedById   String
  assignedAt     DateTime @default(now()) @db.Timestamptz(3)
  removedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           WorkTask @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignee       OrganizationMembership @relation("WorkTaskAssignee", fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)
  assignedBy     OrganizationMembership @relation("WorkTaskAssigner", fields: [organizationId, assignedById], references: [organizationId, userId], onDelete: Restrict)

  @@unique([organizationId, taskId, userId], where: raw("\"removedAt\" IS NULL"), map: "WorkTaskAssignment_one_active_per_user_key")
  @@index([organizationId, userId, removedAt, assignedAt])
  @@index([organizationId, taskId, removedAt])
}

model WorkTaskDependency {
  id                String   @id @default(cuid())
  organizationId    String
  taskId            String
  dependsOnTaskId   String
  createdById       String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task              WorkTask @relation("WorkTaskDependencies", fields: [taskId, organizationId], references: [id, organizationId], onDelete: Restrict)
  dependsOn         WorkTask @relation("WorkTaskDependents", fields: [dependsOnTaskId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy         OrganizationMembership @relation("WorkTaskDependencyCreator", fields: [organizationId, createdById], references: [organizationId, userId], onDelete: Restrict)

  @@unique([organizationId, taskId, dependsOnTaskId])
  @@index([organizationId, dependsOnTaskId])
  @@index([organizationId, taskId])
}

model WorkTaskActivity {
  id             String                 @id @default(cuid())
  organizationId String
  taskId         String
  actorId        String?
  eventType      WorkTaskActivityType
  metadata       Json                   @default("{}")
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           WorkTask               @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor          OrganizationMembership? @relation("WorkTaskActivityActor", fields: [organizationId, actorId], references: [organizationId, userId], onDelete: Restrict)

  @@index([organizationId, taskId, createdAt])
  @@index([organizationId, actorId, createdAt])
}

enum PlanningStyle {
  STRUCTURED
  BALANCED
  FLEXIBLE
}

model UserProfile {
  userId               String        @id
  preferredName        String
  timeZone             String        @default("Asia/Kolkata")
  /// The place the user chose for their time zone, as shown to them ("Bengaluru, Karnataka, India").
  /// Display only: timeZone is what every calculation uses. Null when they picked a zone directly.
  locationLabel        String?       @db.VarChar(160)
  /// Local wall-clock time in HH:mm, interpreted in timeZone; not a UTC timestamp.
  wakeUpTime           String        @default("07:00")
  /// Local wall-clock time in HH:mm, interpreted in timeZone; not a UTC timestamp.
  bedtime              String        @default("22:30")
  /// Optional local wall-clock times in HH:mm, interpreted in timeZone.
  workStartTime        String?
  workEndTime          String?
  workDays             String[]      @default(["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"])
  priorities           String[]      @default([])
  focusSessionMinutes  Int           @default(50)
  breakDurationMinutes Int           @default(10)
  planningStyle        PlanningStyle @default(BALANCED)
  onboardingStep       Int           @default(0)
  onboardingCompleted  Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// The user's own description of themselves, edited in Settings → My Context.
/// It is the editable source of truth for Michael's personalization: nothing
/// generated may overwrite it. Future memory entries or history attach here.
model UserContext {
  userId    String   @id
  summary   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// An uploaded profile picture that overrides the sign-in provider's image.
/// Kept apart from User so the provider's `image` is never overwritten and so
/// profile reads never load image bytes. Removing it falls back to User.image.
model UserProfileImage {
  userId      String   @id
  contentType String   @db.VarChar(32)
  data        Bytes
  byteSize    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id                       String       @id @default(cuid())
  userId                   String
  title                    String       @db.VarChar(160)
  description              String?      @db.Text
  status                   TaskStatus   @default(TODO)
  priority                 TaskPriority @default(MEDIUM)
  estimatedDurationMinutes Int?
  /// Optional user-confirmed work remaining; planning requires this for IN_PROGRESS tasks.
  remainingDurationMinutes Int?
  /// Calendar due date without a time; interpreted as a local date using the owner's time zone.
  dueDate                  DateTime?    @db.Date
  completedAt              DateTime?
  /// The repeating series this task is one occurrence of; null for a one-off task.
  recurrenceId             String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Same owner as the series by construction: the composite key only matches the user's own series.
  recurrence               TaskRecurrence? @relation(fields: [recurrenceId, userId], references: [id, userId], onDelete: NoAction)
  calendarEvents           CalendarEvent[]
  statusHistory             TaskStatusHistory[]
  planningHistory           PersonalTaskPlanHistory[]

  classifications EntityClassification[]
  goalLinks       EntityRelationship[] @relation("EntityRelationshipTask")
  @@unique([id, userId])
  /// One occurrence per series and date: completing twice at once cannot create two next occurrences.
  @@unique([recurrenceId, dueDate])
  @@index([userId, status, dueDate])
  @@index([userId, dueDate])
  @@index([userId, createdAt])
}

/// A repeating task's schedule. Each occurrence is its own Task (with its own history); the next one is
/// created when the current one is completed (src/lib/recurrence.ts). Never deleted while its owner exists:
/// stopping a series sets `active` to false and keeps every occurrence.
model TaskRecurrence {
  id        String              @id @default(cuid())
  userId    String
  frequency RecurrenceFrequency
  /// Every `interval` days, weeks or months (CHECK 1–99).
  interval  Int                 @default(1)
  /// WEEKLY only: ISO weekdays, 1 = Monday … 7 = Sunday.
  weekdays  Int[]               @default([])
  /// MONTHLY only: day of the month; a shorter month uses its last day.
  monthDay  Int?
  /// The first occurrence's due date: the schedule's anchor.
  startsOn  DateTime            @db.Date
  endsOn    DateTime?           @db.Date
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([id, userId])
  @@index([userId, active])
}

/// Immutable personal task status transitions used to preserve daily and historical timeline state.
model TaskStatusHistory {
  id             String     @id @default(cuid())
  userId         String
  taskId         String
  previousStatus TaskStatus?
  status         TaskStatus
  changedAt      DateTime   @default(now()) @db.Timestamptz(3)
  task           Task       @relation(fields: [taskId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, changedAt])
  @@index([taskId, changedAt])
}

/// Private user-owned review notes and intentional skip decisions for a local calendar date.
model DailyReview {
  id                     String   @id @default(cuid())
  userId                 String
  reviewDate             DateTime @db.Date
  wentWell               String?  @db.Text
  challenges             String?  @db.Text
  blockers               String?  @db.Text
  lessonsLearned         String?  @db.Text
  improvements           String?  @db.Text
  intentionallySkippedTaskIds String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewDate])
  @@index([userId, reviewDate])
}

enum PersonalTaskPlanChangeType {
  DUE_DATE_SNAPSHOT
  DUE_DATE_CHANGED
  SESSION_RESCHEDULED
}

/// Immutable snapshots required to reconstruct known due-date and scheduled-time changes.
model PersonalTaskPlanHistory {
  id             String                    @id @default(cuid())
  userId         String
  taskId         String
  changeType     PersonalTaskPlanChangeType
  taskDueDate    DateTime?                 @db.Date
  calendarEventId String?
  plannedStartAt DateTime?                 @db.Timestamptz(3)
  plannedEndAt   DateTime?                 @db.Timestamptz(3)
  timeZone       String?                   @db.VarChar(100)
  title          String?                   @db.VarChar(160)
  recordedAt     DateTime                  @default(now()) @db.Timestamptz(3)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task                      @relation(fields: [taskId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, taskId, recordedAt])
  @@index([userId, taskDueDate, recordedAt])
  @@index([userId, plannedStartAt, plannedEndAt])
}

enum AiProductContext {
  LIFESTYLE
  WORK
}

enum AiMessageRole {
  USER
  ASSISTANT
}

/// A saved Michael AI conversation. Private to its owner; a WORK conversation
/// is additionally readable only while the owner's organization membership is
/// active, because org data is quoted inside its messages.
model AiConversation {
  id             String            @id @default(cuid())
  userId         String
  product        AiProductContext
  /// Required for WORK, always null for LIFESTYLE. Enforced in the service.
  organizationId String?
  /// Derived from the first user message; never generated by a model.
  title          String            @db.VarChar(120)
  messageCount   Int               @default(0)
  lastMessageAt  DateTime?         @db.Timestamptz(3)
  archivedAt     DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       AiConversationMessage[]

  @@unique([id, userId])
  @@index([userId, product, lastMessageAt])
  @@index([userId, archivedAt, lastMessageAt])
  @@index([organizationId])
}

/// One turn. Append-only: a stored message is never edited to reflect a later
/// state, matching the history rule for tasks.
model AiConversationMessage {
  id             String         @id @default(cuid())
  conversationId String
  userId         String
  role           AiMessageRole
  content        String         @db.Text
  /// Which tools ran for this turn, as the chat route reported them.
  toolActivity   Json           @default("[]")
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  conversation   AiConversation @relation(fields: [conversationId, userId], references: [id, userId], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

/// Universal data foundation (CLAUDE.md §10.4, docs/architecture/michael-intelligence.md B.3).
/// The catalog is generated from shared/taxonomy/registry.json by a migration; never edit rows by hand.
enum TaxonomyNamespace {
  CORE
  PERSONAL
  WORK
  INDUSTRY
  INTELLIGENCE
  PLATFORM
}

/// Phase 6: what a person did with something Michael offered. A fixed list; see OutcomeEvent.
enum OutcomeKind {
  DRAFT_SAVED
  DRAFT_DISCARDED
  SUGGESTION_SHOWN
  SUGGESTION_CONFIRMED
  SUGGESTION_DISMISSED
  PLAN_SESSION_KEPT
  PLAN_SESSION_DESELECTED
  PROPOSAL_ACCEPTED
  PROPOSAL_DISMISSED
}

enum DataSensitivity {
  STANDARD
  PERSONAL
  SENSITIVE
}

/// What data in a category may be used for. Sensitive categories never include ASSISTANT_CONTEXT.
enum DataPurpose {
  ASSISTANT_CONTEXT
  PLANNING
  INSIGHTS
  ORGANIZATION_REPORTING
}

enum RetentionPolicy {
  /// Lives exactly as long as the record it describes.
  FOLLOWS_RECORD
}

enum TaxonomyStatus {
  ACTIVE
  DEPRECATED
}

enum ClassifiableEntityType {
  TASK
  GOAL
  HABIT
  CALENDAR_EVENT
  WORK_TASK
  PROJECT
}

/// Where a piece of information came from. AI_* is never shown as user fact.
enum DataSource {
  USER_INPUT
  INTEGRATION
  DEVICE_OBSERVATION
  APP_ACTIVITY
  AI_INFERENCE
  AI_PREDICTION
  IMPORT
}

/// A registered category: a domain (level 2) or subdomain (level 3). Never deleted; deprecated instead.
model TaxonomyCategory {
  key               String                   @id @db.VarChar(120)
  namespace         TaxonomyNamespace
  level             Int                      @db.SmallInt
  parentKey         String?                  @db.VarChar(120)
  name              String                   @db.VarChar(120)
  description       String                   @db.VarChar(500)
  sensitivity       DataSensitivity
  permittedPurposes DataPurpose[]
  retention         RetentionPolicy
  /// Which record types may be classified into this category.
  entityTypes       ClassifiableEntityType[]
  status            TaxonomyStatus           @default(ACTIVE)
  schemaVersion     Int
  registryVersion   Int
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  parent            TaxonomyCategory?        @relation("TaxonomyHierarchy", fields: [parentKey], references: [key], onDelete: Restrict)
  children          TaxonomyCategory[]       @relation("TaxonomyHierarchy")
  classifications   EntityClassification[]

  @@index([namespace, status, level])
  @@index([parentKey])
}

/// One existing record placed in one category. Exactly one record column is
/// set, and personal records carry userId only while work records carry
/// organizationId only (CHECK in the migration). Each record relation includes
/// the owner column, so the database refuses a row whose owner differs from its
/// record's, and the row disappears with the record, the user or the
/// organization.
/// The kinds of link between two existing records (CLAUDE.md §10.4). Each kind names its two record columns
/// and the migration's CHECK enforces them.
enum RelationshipKind {
  /// A personal task contributes to one of the same user's goals (taskId → goalId). Drives goal alignment
  /// in task prioritization.
  TASK_SUPPORTS_GOAL
}

/// One typed link between two existing records, never a copy of either (§10.4). Same pattern as
/// EntityClassification: one nullable foreign key per record type, each composite with the owner column, so the
/// database refuses a link across users and deletes it with either record or the user. The CHECK in the
/// migration requires, per kind, exactly its two records and the matching scope column. Only personal kinds
/// exist; a work kind adds organizationId and widens the CHECK.
model EntityRelationship {
  id         String           @id @default(cuid())
  userId     String?
  kind       RelationshipKind
  taskId     String?
  goalId     String?
  /// USER_INPUT for every row today: Michael does not propose links yet.
  source     DataSource
  recordedAt DateTime         @default(now()) @db.Timestamptz(3)
  user       User?            @relation("EntityRelationshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  task       Task?            @relation("EntityRelationshipTask", fields: [taskId, userId], references: [id, userId], onDelete: Cascade)
  goal       Goal?            @relation("EntityRelationshipGoal", fields: [goalId, userId], references: [id, userId], onDelete: Cascade)

  /// Serves the task-side read ([userId, kind, taskId IN …]) as well as uniqueness.
  @@unique([userId, kind, taskId, goalId, source])
  @@index([userId, goalId])
}

model EntityClassification {
  id              String           @id @default(cuid())
  userId          String?
  organizationId  String?
  taskId          String?
  goalId          String?
  habitId         String?
  calendarEventId String?
  workTaskId      String?
  projectId       String?
  categoryKey     String           @db.VarChar(120)
  source          DataSource
  /// 0–1, required for AI_INFERENCE and AI_PREDICTION and null otherwise (CHECK in the migration).
  confidence      Decimal?         @db.Decimal(4, 3)
  /// Detail beyond the source kind, such as the model and prompt version. Never user content.
  sourceRef       String?          @db.VarChar(200)
  /// The member who added a WorkOS classification; null for personal rows and inferences.
  createdById     String?
  recordedAt      DateTime         @default(now()) @db.Timestamptz(3)
  category        TaxonomyCategory @relation(fields: [categoryKey], references: [key], onDelete: Restrict)
  user            User?            @relation("EntityClassificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("EntityClassificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task            Task?            @relation(fields: [taskId, userId], references: [id, userId], onDelete: Cascade)
  goal            Goal?            @relation(fields: [goalId, userId], references: [id, userId], onDelete: Cascade)
  habit           Habit?           @relation(fields: [habitId, userId], references: [id, userId], onDelete: Cascade)
  calendarEvent   CalendarEvent?   @relation(fields: [calendarEventId, userId], references: [id, userId], onDelete: Cascade)
  workTask        WorkTask?        @relation(fields: [workTaskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// One row per record, category and source: a user's confirmation sits beside the inference it confirms.
  @@unique([userId, taskId, categoryKey, source])
  @@unique([userId, goalId, categoryKey, source])
  @@unique([userId, habitId, categoryKey, source])
  @@unique([userId, calendarEventId, categoryKey, source])
  @@unique([organizationId, workTaskId, categoryKey, source])
  @@unique([organizationId, projectId, categoryKey, source])
  @@index([userId, categoryKey])
  @@index([organizationId, categoryKey])
  @@index([createdById])
}

/// Phase 5 memory: one short note Michael may read, owned by one user (LifestyleOS) or one organization
/// (WorkOS), never both (CHECK). Never promoted from a conversation: every row today is saved by a person
/// (USER_INPUT), from Settings or from a draft Michael proposed. Inference rows wait for Phase 6.
/// An edit adds a version that supersedes the current one (history); a delete removes every version.
model MemoryItem {
  id             String          @id @default(cuid())
  userId         String?
  organizationId String?
  /// The first version's id, on every later version; null on the first version itself (CHECK).
  lineageId      String?
  /// The version this one replaced, read under the same owner in the same transaction.
  supersedesId   String?         @unique
  content        String          @db.VarChar(280)
  /// SENSITIVE never reaches a model; PERSONAL only a paid-tier or local provider.
  sensitivity    DataSensitivity @default(STANDARD)
  source         DataSource
  /// 0–1, required for AI_INFERENCE and AI_PREDICTION and null otherwise (CHECK in the migration).
  confidence     Decimal?        @db.Decimal(4, 3)
  /// Detail beyond the source kind, such as the model and prompt version. Never user content.
  sourceRef      String?         @db.VarChar(200)
  /// The member who wrote a WorkOS memory version; null for personal rows.
  createdById    String?
  /// Optional end of relevance; an expired memory is never read for Michael.
  expiresAt      DateTime?       @db.Timestamptz(3)
  /// Set when a newer version replaces this one; the current version has none.
  supersededAt   DateTime?       @db.Timestamptz(3)
  recordedAt     DateTime        @default(now()) @db.Timestamptz(3)
  user           User?           @relation("MemoryItemOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("MemoryItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supersedes     MemoryItem?     @relation("MemoryItemVersions", fields: [supersedesId], references: [id], onDelete: Cascade)
  supersededBy   MemoryItem?     @relation("MemoryItemVersions")

  /// The current list: owner, current versions only, newest first.
  @@index([userId, supersededAt, recordedAt])
  @@index([organizationId, supersededAt, recordedAt])
  /// Deleting a memory removes its lineage under the same owner.
  @@index([userId, lineageId])
  @@index([organizationId, lineageId])
  @@index([createdById])
}

/// Phase 6 feedback: one outcome of something Michael offered — a draft saved or discarded, a category
/// suggestion shown, confirmed or dismissed, a planned session kept or removed, a learned proposal
/// accepted or dismissed. Provenance is APP_ACTIVITY. Append-only: never updated, deleted only with its
/// owner. Owned by one user xor one organization (CHECK). Holds no user content: `subject` is from a
/// fixed vocabulary (a draft kind, a registered category key, a proposal key), checked in the migration.
model OutcomeEvent {
  id              String        @id @default(cuid())
  userId          String?
  organizationId  String?
  /// WorkOS only: the member who acted; null once their account is gone.
  actorUserId     String?
  kind            OutcomeKind
  subject         String        @db.VarChar(80)
  /// Planned sessions only: local start hour (0–23) and length. Null for every other kind (CHECK).
  localHour       Int?          @db.SmallInt
  durationMinutes Int?
  recordedAt      DateTime      @default(now()) @db.Timestamptz(3)
  user            User?         @relation("OutcomeEventOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor           User?         @relation("OutcomeEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Proposals and summaries read one owner's events of a kind over a date range.
  @@index([userId, kind, recordedAt])
  @@index([organizationId, kind, recordedAt])
  @@index([actorUserId])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum GoalMilestoneStatus {
  PENDING
  COMPLETED
}

model Goal {
  id          String          @id @default(cuid())
  userId      String
  title       String          @db.VarChar(160)
  description String?         @db.Text
  category    String?         @db.VarChar(80)
  status      GoalStatus      @default(ACTIVE)
  /// Manually maintained progress percentage; milestone completion does not change it.
  progress    Int             @default(0)
  /// Calendar target date without a time; interpreted in the owner's time zone.
  targetDate  DateTime?       @db.Date
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  GoalMilestone[]

  classifications EntityClassification[]
  taskLinks       EntityRelationship[] @relation("EntityRelationshipGoal")

  /// Lets classifications reference (id, userId), so the owner is enforced by the database.
  @@unique([id, userId])
  @@index([userId, status])
  @@index([userId, targetDate])
  @@index([userId, createdAt])
}

model GoalMilestone {
  id          String              @id @default(cuid())
  goalId      String
  title       String              @db.VarChar(160)
  description String?             @db.Text
  status      GoalMilestoneStatus @default(PENDING)
  position    Int                 @default(0)
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  goal        Goal                @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, position])
  @@index([goalId, status])
}

enum HabitFrequency {
  DAILY
  SELECTED_DAYS
}

enum HabitStatus {
  ACTIVE
  ARCHIVED
}

enum CalendarEventType {
  TASK_SESSION
  COMMITMENT
  UNAVAILABLE
}

enum SchedulingMode {
  FIXED
  FLEXIBLE
}

/// A persisted calendar interval. Timestamps are absolute instants; timeZone
/// retains the IANA zone used for local display and calendar operations.
model CalendarEvent {
  id             String            @id @default(cuid())
  userId         String
  taskId         String?
  eventType      CalendarEventType
  schedulingMode SchedulingMode
  title          String            @db.VarChar(160)
  description    String?           @db.Text
  startAt        DateTime          @db.Timestamptz(3)
  endAt          DateTime          @db.Timestamptz(3)
  timeZone       String            @db.VarChar(100)
  /// Retains scheduled work history while removing invalidated future sessions from active calendars.
  cancelledAt    DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Removing a task removes only its task sessions; unrelated commitments remain.
  task           Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  classifications EntityClassification[]

  /// Lets classifications reference (id, userId), so the owner is enforced by the database.
  @@unique([id, userId])
  @@index([userId, startAt])
  @@index([userId, endAt])
  @@index([userId, startAt, endAt])
  @@index([taskId])
}

/// Weekly availability using ISO weekdays (Monday = 1 through Sunday = 7).
/// Local clock values are HH:mm strings interpreted in timeZone.
model AvailabilityWindow {
  id        String   @id @default(cuid())
  userId    String
  weekday   Int
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)
  timeZone  String   @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active, weekday])
}

model Habit {
  id          String         @id @default(cuid())
  userId      String
  title       String         @db.VarChar(160)
  description String?        @db.Text
  frequency   HabitFrequency @default(DAILY)
  /// ISO weekdays: Monday = 1 through Sunday = 7. Empty for DAILY habits.
  weekdays    Int[]          @default([])
  /// Optional local wall-clock time in HH:mm, interpreted in the profile timeZone.
  startTime   String?        @db.VarChar(5)
  /// Optional local HH:mm; only set with startTime. Earlier than startTime means it ends the next day.
  endTime     String?        @db.VarChar(5)
  status      HabitStatus    @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns    HabitCheckIn[]

  classifications EntityClassification[]

  /// Lets classifications reference (id, userId), so the owner is enforced by the database.
  @@unique([id, userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model HabitCheckIn {
  id          String   @id @default(cuid())
  habitId     String
  /// User-local calendar date; stored as PostgreSQL DATE, not a timestamp.
  localDate   DateTime @db.Date
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, localDate])
  @@index([habitId, localDate])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
