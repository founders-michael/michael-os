# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!services/planner/.env.example
!services/intelligence/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python planner
services/planner/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
services/planner/.env

.claude
# Python intelligence service
services/intelligence/.venv/
services/intelligence/.env
services/intelligence/*.egg-info/

# Live evaluation reports (npm run eval:live): local results, not committed.
services/intelligence/evals/reports/

# Rendered email previews (npm run email:preview): local only.
.email-previews/
