# Bearer secret shared with the Next.js server (INTELLIGENCE_SERVICE_TOKEN there). At least 32 characters.
INTELLIGENCE_SERVICE_TOKEN=replace-with-a-long-random-secret
# development | production. Production refuses the local model and Gemini's unpaid tier.
INTELLIGENCE_ENV=development

# Must match AI_PROVIDER in the Next.js environment; a mismatch is refused before any data is sent.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DATA_TIER=unpaid

AI_MAX_TOOL_CALLS=5
AI_MAX_ITERATIONS=4
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_CHARS=6000
